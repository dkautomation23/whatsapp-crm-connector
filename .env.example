# Copy to .env and fill in. The real .env is git-ignored - never commit tokens.

# DEMO_MODE=true runs everything locally with the sample webhooks and makes no
# outbound calls. Set it to false only once the values below are real.
DEMO_MODE=true

# --- Meta WhatsApp Business Cloud API ----------------------------------
# App secret: used to verify X-Hub-Signature-256 on every webhook.
META_APP_SECRET=your_app_secret
# Any string you choose; Meta echoes it back during the webhook handshake.
META_VERIFY_TOKEN=choose_a_long_random_string
# Long-lived access token (system user token recommended for production).
META_ACCESS_TOKEN=your_long_lived_token
# From WhatsApp > API Setup in the Meta app dashboard.
WHATSAPP_PHONE_NUMBER_ID=000000000000000
META_GRAPH_VERSION=v21.0

# --- CRM ----------------------------------------------------------------
# Left empty in demo mode: the local SQLite store plays the role of the CRM.
CRM_BASE_URL=
CRM_API_KEY=

# --- behaviour ----------------------------------------------------------
STATE_PATH=state.sqlite3
MAX_RETRIES=4
RETRY_BASE_SECONDS=0.5
# Refresh the long-lived token when it is this many days from expiring.
TOKEN_REFRESH_MARGIN_DAYS=7
